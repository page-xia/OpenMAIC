# dependencies
# `**/` matters: a bare `node_modules` matches only the context root, so
# workspace packages keep their own (pnpm-created) node_modules in the build
# context and collide with the deps stage's when `COPY . .` merges the two.
**/node_modules
.pnpm-store

# build output
.next
out
build
**/dist

# git
.git
.gitignore

# IDE
.idea
.vscode

# env & secrets
.env*
!.env.example
server-providers*.yml

# misc
assets
*.md
*.pdf
*.pem
.DS_Store
.vercel
coverage
logs
data
docs
.claude

# isolated MP4 render service — built as its own image (render-service/Dockerfile),
# never part of the main app image.
render-service
